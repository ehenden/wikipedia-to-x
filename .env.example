# Publishing credentials (never commit actual values)
BUFFER_API_KEY=your_buffer_api_key
BUFFER_CHANNEL_ID=your_buffer_x_channel_id

# Selection
WIKI_LANGUAGE=tr
ARTICLE_SOURCE=popular
# Category mode uses an existing category in the selected edition.
# WIKI_CATEGORY=Category:Physics

# History and random candidate filtering
HISTORY_DAYS=60
TOPIC_DAYS=14
RN_MINSIZE=8000
POST_INTERVAL=1800
# Optional read-only confirmation after Buffer accepts a post (Actions enables it).
VERIFY_DELIVERY=false
