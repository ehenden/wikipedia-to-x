# X (Twitter) API Credentials
# Get these from https://developer.twitter.com/
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Bot Configuration
PUBLISH_PROVIDER=twitter
# For Buffer publishing, set PUBLISH_PROVIDER=buffer and supply both values.
BUFFER_API_KEY=your_buffer_api_key_here
BUFFER_CHANNEL_ID=your_buffer_x_channel_id_here
# Interval between posts in seconds (default: 3600 = 1 hour)
POST_INTERVAL=3600

# Optional filters / randomness
# Don't repeat the same article for N days (default: 60)
HISTORY_DAYS=60
# Try to avoid repeating the same topic for N days (default: 14)
TOPIC_DAYS=14
# Random page minimum size in bytes (default: 8000)
RN_MINSIZE=8000
